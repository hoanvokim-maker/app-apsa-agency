# APSA - rewrite cho link rut gon:  /u/<ma>  ->  /u.php?c=<ma>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^u/([A-Za-z0-9_-]{3,32})/?$ /u.php?c=$1 [L,QSA]
    # Trang duyet video: render <title> + og:* phia server
    RewriteRule ^review\.html$ /review.php [L,QSA]
    # Playlist duyet video: render <title> + og:* phia server
    RewriteRule ^playlist\.html$ /playlist.php [L,QSA]
    # Bao gia / nghiem thu: tieu de link = ma + ten du an
    RewriteRule ^quotation\.html$ /quotation.php [L,QSA]
</IfModule>
